# Used by `npm run dev:emulator`: runs Vyro against local Firebase emulators,
# so you can try the Firebase version without a real project. Not secret.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-vyro.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-vyro
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_USE_EMULATOR=true

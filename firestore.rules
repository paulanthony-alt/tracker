rules_version = '2';

// Vyro — only the single owner account can read or write.
//
// The app signs in with one fixed email (you only ever type the password).
// If you change OWNER_EMAIL in src/lib/firebaseConfig.ts, change it here too.
// Data lives at vyro/owner/{collection}/{id}, independent of the account's uid,
// so resetting the account (delete + set a new password) keeps your data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'vyro-owner@example.com';
    }

    function knownCollection(name) {
      return name in ['tasks', 'classes', 'projects', 'habits', 'goals', 'events',
                      'reminders', 'notes', 'journal', 'dayPlans', 'reviews', 'settings',
                      // Devices registered for push notifications (written by the app).
                      'devices',
                      // Google Classroom / Calendar connection: the sync key and import
                      // bookkeeping (links), and what the Google sync script sent (inbox).
                      'links', 'inbox'];
    }

    // The sync key the Google script must present. Lives in vyro/owner/links/key.
    function syncKey() {
      return get(/databases/$(database)/documents/vyro/owner/links/key).data.key;
    }

    match /vyro/owner/{collection}/{docId} {
      allow read, delete: if isOwner() && knownCollection(collection);
      // Every record must carry its own id, matching the document id.
      allow create, update: if isOwner() && knownCollection(collection)
        && request.resource.data.id == docId;
    }

    // The Google Apps Script isn't signed in to Vyro. It may only replace its own
    // inbox document, and only with the secret sync key shown in Settings →
    // Connections. It can't read anything, and can't touch your real records.
    match /vyro/owner/inbox/{docId} {
      allow create, update: if docId.matches('^(classroom|calendar)-[a-z0-9]{6,40}$')
        && request.resource.data.keys().hasOnly(['id', 'key', 'source', 'account', 'syncedAt', 'from', 'to', 'items'])
        && request.resource.data.id == docId
        && request.resource.data.source == docId.split('-')[0]
        && request.resource.data.key is string
        && request.resource.data.key.size() >= 32
        && request.resource.data.key == syncKey()
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 600;
    }

    // Everything else is closed. (The notification sender uses the Admin SDK,
    // which bypasses these rules, to record what it has already sent.)
    match /{path=**} {
      allow read, write: if false;
    }
  }
}

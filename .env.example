# Copy to .env and fill in.

# --- Firebase (free Spark plan): sync across all your devices -------------------
# From Firebase console → Project settings → Your apps → Web app (</>) → config.
# These identify your project; they are not secrets. Your password and
# firestore.rules are what protect your data. Leave blank to use the local server.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Local server mode only (npm start) ----------------------------------------
# These are read by the server and never sent to the browser.

# Optional: enables the AI assistant (summaries, day planning, priority suggestions).
ANTHROPIC_API_KEY=
# Optional: override the model the assistant uses.
ANTHROPIC_MODEL=claude-opus-5-5

# Port for the production server (npm start). Dev API uses API_PORT (default 3001).
PORT=3000

# Bind address. 127.0.0.1 keeps your data private to this computer.
# Use 0.0.0.0 to reach it from other devices on your network (no login — trusted networks only).
HOST=127.0.0.1

# Where the SQLite database and daily backups are stored.
DATA_DIR=data
